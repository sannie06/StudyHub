                    </div>
                    <div class="d-flex justify-content-between p-1 bg-light rounded border px-2">
                        <div>
                            <div class="fw-bold text-dark">Tạo nhóm học tập</div>
                            <span class="text-secondary" style="font-size:0.65rem;">01/06/2024 09:30:25</span>
                        </div>
                        <span class="text-secondary align-self-center">113.161.12.45</span>
                    </div>
                    <div class="d-flex justify-content-between p-1 bg-light rounded border px-2">
                        <div>
                            <div class="fw-bold text-dark">Sử dụng AI Assistant</div>
                            <span class="text-secondary" style="font-size:0.65rem;">01/06/2024 09:15:40</span>
