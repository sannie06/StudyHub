<!-- Info banner banner -->
<div class="alert alert-info border d-flex gap-2 align-items-start" style="border-radius:12px;">
    <i class="fa-solid fa-circle-info fs-5 mt-1"></i>
    <div>
        <h6 class="fw-bold mb-1">Hướng dẫn quản lý người dùng</h6>
        <ul class="m-0 ps-3 small">
            <li>Nhấp vào hàng của bất kỳ người dùng nào trong danh sách để hiển thị thông tin chi tiết và lịch sử hoạt động ở bảng bên phải.</li>
            <li>Sử dụng các nút thao tác nhanh để thay đổi trạng thái, vai trò, hoặc đặt lại mật khẩu nhanh chóng.</li>
            <li>Có thể sử dụng ô tìm kiếm để lọc người dùng theo mã SV, email, hoặc tên.</li>
        </ul>
    </div>
</div>

@section Scripts {
    <script>
        // Details panel interactive update
        function viewUserDetails(id, name, email, role, status, date) {
            $('#detailId').text(id);
            $('#detailName').text(name);
            $('#detailFullName').text(name);
            $('#detailEmail').text(email);
            $('#detailRoleBadge').text(role);
            $('#detailCreateDate').text(date + ' 10:15');
            $('#detailStatusBadge').text(status);
            
            // Set avatar mock
            let avatarUrl = "https://images.unsplash.com/photo-1494790108377-be9c29b29330?auto=format&fit=crop&w=120&q=80"; // Default Trần Thị Bình
            if (id === 'SV0001') avatarUrl = "https://images.unsplash.com/photo-1535713875002-d1d0cf377fde?auto=format&fit=crop&w=120&q=80";
            if (id === 'SV0003') avatarUrl = "https://images.unsplash.com/photo-1599566150163-29194dcaad36?auto=format&fit=crop&w=120&q=80";
            if (id === 'SV0004') avatarUrl = "https://images.unsplash.com/photo-1507003211169-0a1dd7228f2d?auto=format&fit=crop&w=120&q=80";
            if (id === 'AD0001') avatarUrl = "https://images.unsplash.com/photo-1570295999919-56ceb5ecca61?auto=format&fit=crop&w=120&q=80";
            $('#detailAvatar').attr('src', avatarUrl);

            // Set role classes
            if (role === 'Sinh viên') {
                $('#detailRoleBadge').removeClass('bg-warning text-warning').addClass('bg-primary text-primary');
            } else {
                $('#detailRoleBadge').removeClass('bg-primary text-primary').addClass('bg-warning text-warning');
            }

            // Set status classes
            if (status === 'Đang hoạt động') {
                $('#detailStatusBadge').removeClass('bg-danger text-danger').addClass('bg-success text-success').text('Đang hoạt động');
                $('#quickLockBtn').html('<i class="fa-solid fa-lock me-1"></i> Khóa account').removeClass('btn-outline-success').addClass('btn-outline-danger');
            } else {
                $('#detailStatusBadge').removeClass('bg-success text-success').addClass('bg-danger text-danger').text('Đã khóa');
                $('#quickLockBtn').html('<i class="fa-solid fa-lock-open me-1"></i> Mở khóa').removeClass('btn-outline-danger').addClass('btn-outline-success');
            }

            // Set active table row visual feedback
            $('#userTable tbody tr').removeClass('active bg-light');
            
            // Find row containing the ID
            $('#userTable tbody tr').each(function() {
                if ($(this).find('td:nth-child(2)').text() === id) {
                    $(this).addClass('active bg-light');
                }
            });
            
            // Update logs mock
            let logsHtml = `
                <div class="d-flex justify-content-between p-1 bg-light rounded border px-2">
                    <div>
                        <div class="fw-bold text-dark">Sử dụng hệ thống</div>
                        <span class="text-secondary" style="font-size:0.65rem;">${date} 09:45:12</span>
                    </div>
                    <span class="text-secondary align-self-center">113.161.12.45</span>
                </div>
                <div class="d-flex justify-content-between p-1 bg-light rounded border px-2">
                    <div>
                        <div class="fw-bold text-dark">Tra cứu tài liệu</div>
                        <span class="text-secondary" style="font-size:0.65rem;">${date} 09:30:25</span>
                    </div>
                    <span class="text-secondary align-self-center">113.161.12.45</span>
                </div>
            `;
            $('#activityLogsBlock').html(logsHtml);
        }

        // Lock/Unlock triggers
        function lockUserAccount(userId) {
            Swal.fire({
                title: 'Khóa tài khoản?',
                text: `Bạn có chắc chắn muốn khóa tài khoản người dùng ${userId}?`,
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#d33',
                cancelButtonColor: '#3085d6',
                confirmButtonText: 'Khóa ngay',
                cancelButtonText: 'Hủy bỏ'
            }).then((result) => {
                if (result.isConfirmed) {
                    Swal.fire('Đã khóa!', 'Tài khoản người dùng đã bị tạm ngưng.', 'success');
                    // update status in UI table
                    updateTableUserStatus(userId, 'Đã khóa');
                }
            });
        }

        function unlockUserAccount(userId) {
            Swal.fire({
                title: 'Mở khóa tài khoản?',
                text: `Kích hoạt lại tài khoản cho người dùng ${userId}?`,
                icon: 'question',
                showCancelButton: true,
                confirmButtonColor: '#10b981',
                cancelButtonColor: '#3085d6',
                confirmButtonText: 'Mở khóa',
                cancelButtonText: 'Hủy'
            }).then((result) => {
                if (result.isConfirmed) {
                    Swal.fire('Đã mở khóa!', 'Tài khoản người dùng đã có thể sử dụng bình thường.', 'success');
                    updateTableUserStatus(userId, 'Đang hoạt động');
                }
            });
        }

        function toggleLockCurrentAccount() {
            let currentId = $('#detailId').text();
            let currentStatus = $('#detailStatusBadge').text();
            if (currentStatus === 'Đang hoạt động') {
                lockUserAccount(currentId);
            } else {
                unlockUserAccount(currentId);
            }
        }

        function updateTableUserStatus(userId, status) {
            $('#userTable tbody tr').each(function() {
                if ($(this).find('td:nth-child(2)').text() === userId) {
                    if (status === 'Đang hoạt động') {
                        $(this).find('td:nth-child(6)').html('<span class="badge bg-success bg-opacity-10 text-success">Đang hoạt động</span>');
                        $(this).find('.fa-lock-open').removeClass('fa-lock-open').addClass('fa-lock').parent().removeClass('text-success').addClass('text-danger').attr('onclick', `lockUserAccount('${userId}')`);
                    } else {
                        $(this).find('td:nth-child(6)').html('<span class="badge bg-danger bg-opacity-10 text-danger">Đã khóa</span>');
                        $(this).find('.fa-lock').removeClass('fa-lock').addClass('fa-lock-open').parent().removeClass('text-danger').addClass('text-success').attr('onclick', `unlockUserAccount('${userId}')`);
                    }
                    
                    // refresh current details view if active
                    if ($('#detailId').text() === userId) {
                        let name = $(this).find('td:nth-child(3)').text();
                        let email = $(this).find('td:nth-child(4)').text();
                        let role = $(this).find('td:nth-child(5)').text();
                        let date = $(this).find('td:nth-child(7)').text();
                        viewUserDetails(userId, name, email, role, status, date);
                    }
                }
            });
        }

        function deleteUserAccount() {
            let currentId = $('#detailId').text();
            Swal.fire({
                title: 'Xóa tài khoản vĩnh viễn?',
                text: `Hành động này không thể hoàn tác! Bạn chắc chắn muốn xóa tài khoản ${currentId}?`,
                icon: 'error',
                showCancelButton: true,
                confirmButtonColor: '#ef4444',
                cancelButtonColor: '#3085d6',
                confirmButtonText: 'Xóa vĩnh viễn',
                cancelButtonText: 'Quay lại'
            }).then((result) => {
                if (result.isConfirmed) {
                    Swal.fire('Đã xóa!', 'Tài khoản người dùng đã được xóa khỏi hệ thống.', 'success');
                    
                    // remove row from table
                    $('#userTable tbody tr').each(function() {
                        if ($(this).find('td:nth-child(2)').text() === currentId) {
                            $(this).remove();
                        }
                    });
                    
                    // switch details back to default Trần Thị Bình SV0002
                    viewUserDetails('SV0002', 'Trần Thị Bình', 'tranthibinh@gmail.com', 'Sinh viên', 'Đang hoạt động', '01/06/2024');
                }
            });
        }

        // Live table search filtering
        function filterUserTable() {
            var searchVal = $('#userSearchInput').val().toLowerCase();
            $('#userTable tbody tr').each(function() {
                var text = $(this).text().toLowerCase();
                if (text.indexOf(searchVal) > -1) {
                    $(this).show();
                } else {
                    $(this).hide();
                }
            });
        }
    </script>
}
