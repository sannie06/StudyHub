@{
    ViewData["Title"] = "Quản lý người dùng - Admin Panel";
}

<!-- Title and Subtitle -->
<div class="row align-items-center mb-4">
    <div class="col-md-8">
        <h2 class="fw-bold mb-1" style="font-size: 1.8rem;">Quản lý người dùng</h2>
        <p class="text-secondary mb-0">Quản lý toàn bộ tài khoản người dùng trong hệ thống.</p>
    </div>
</div>

<!-- Stats Row -->
<div class="row g-4 mb-4">
    <!-- Stat 1 -->
    <div class="col-xl-3 col-sm-6">
        <div class="glass-card d-flex align-items-center gap-3">
            <div class="bg-primary bg-opacity-10 text-primary rounded-circle p-3 d-flex align-items-center justify-content-center" style="width: 50px; height: 50px;">
                <i class="fa-solid fa-users fs-5"></i>
            </div>
            <div>
                <span class="text-secondary small fw-bold">Tổng người dùng</span>
                <h4 class="fw-bold mb-0">1.250</h4>
                <span class="text-secondary" style="font-size: 0.72rem;">Tất cả tài khoản</span>
            </div>
        </div>
    </div>
    <!-- Stat 2 -->
    <div class="col-xl-3 col-sm-6">
        <div class="glass-card d-flex align-items-center gap-3">
            <div class="bg-success bg-opacity-10 text-success rounded-circle p-3 d-flex align-items-center justify-content-center" style="width: 50px; height: 50px;">
                <i class="fa-solid fa-user-check fs-5"></i>
            </div>
            <div>
                <span class="text-secondary small fw-bold">Đang hoạt động</span>
                <h4 class="fw-bold mb-0">1.200</h4>
                <span class="text-success fw-bold" style="font-size: 0.72rem;">96% tài khoản</span>
            </div>
        </div>
    </div>
    <!-- Stat 3 -->
    <div class="col-xl-3 col-sm-6">
        <div class="glass-card d-flex align-items-center gap-3">
            <div class="bg-warning bg-opacity-10 text-warning rounded-circle p-3 d-flex align-items-center justify-content-center" style="width: 50px; height: 50px;">
                <i class="fa-solid fa-user-slash fs-5"></i>
            </div>
            <div>
                <span class="text-secondary small fw-bold">Đã khóa</span>
                <h4 class="fw-bold mb-0">50</h4>
                <span class="text-danger fw-bold" style="font-size: 0.72rem;">4% tài khoản</span>
            </div>
        </div>
    </div>
    <!-- Stat 4 -->
    <div class="col-xl-3 col-sm-6">
        <div class="glass-card d-flex align-items-center gap-3">
            <div class="bg-danger bg-opacity-10 text-danger rounded-circle p-3 d-flex align-items-center justify-content-center" style="width: 50px; height: 50px;">
                <i class="fa-solid fa-user-shield fs-5"></i>
            </div>
            <div>
                <span class="text-secondary small fw-bold">Quản trị viên</span>
                <h4 class="fw-bold mb-0">5</h4>
                <span class="text-secondary" style="font-size: 0.72rem;">0.4% tài khoản</span>
            </div>
        </div>
    </div>
</div>

<!-- Main Area Split: Left List, Right Profile Details Panel -->
<div class="row g-4 mb-4">
    <!-- Users list block (8 columns) -->
    <div class="col-xl-8 col-lg-12">
        <div class="glass-card h-100 p-3">
            
            <!-- Filters Bar -->
            <div class="d-flex flex-wrap gap-2 justify-content-between align-items-center mb-3">
                <div class="d-flex gap-2 align-items-center">
                    <div class="position-relative" style="width: 220px;">
                        <i class="fa-solid fa-magnifying-glass text-secondary" style="position: absolute; left: 10px; top: 50%; transform: translateY(-50%); font-size:0.8rem;"></i>
                        <input type="text" class="glass-control p-1 ps-4" style="font-size:0.85rem;" placeholder="Tìm kiếm người dùng..." id="userSearchInput" onkeyup="filterUserTable()" />
                    </div>
                    <select class="glass-control p-1 border" style="width: auto; font-size:0.85rem;">
                        <option>Tất cả vai trò</option>
                        <option>Sinh viên</option>
                        <option>Quản trị viên</option>
                    </select>
                    <select class="glass-control p-1 border" style="width: auto; font-size:0.85rem;">
                        <option>Tất cả trạng thái</option>
                        <option>Đang hoạt động</option>
                        <option>Đã khóa</option>
                    </select>
                </div>
                <div class="d-flex gap-2">
                    <button class="btn btn-secondary-custom btn-sm px-3" onclick="location.reload()"><i class="fa-solid fa-arrows-rotate me-1"></i> Làm mới</button>
                    <button class="btn btn-primary-custom btn-sm px-3" onclick="Swal.fire('Thêm người dùng', 'Form thêm tài khoản mới...', 'info')"><i class="fa-solid fa-plus me-1"></i> Thêm người dùng</button>
                </div>
            </div>

            <!-- Table of users -->
            <div class="table-responsive">
                <table class="glass-table table align-middle" id="userTable">
                    <thead>
                        <tr>
                            <th>#</th>
                            <th>Mã người dùng</th>
