    <!-- Right Side Details Panel (4 columns) -->
    <div class="col-xl-4 col-lg-12">
        <!-- Details Card -->
        <div class="glass-card mb-4 p-3">
            <div class="card-title-custom mb-3">
                <span class="text-dark">Thông tin chi tiết</span>
                <i class="fa-solid fa-ellipsis cursor-pointer"></i>
            </div>
            
            <!-- User Photo Circle & Info block -->
            <div class="d-flex flex-column align-items-center text-center mb-4">
                <img src="https://images.unsplash.com/photo-1494790108377-be9c29b29330?auto=format&fit=crop&w=120&q=80" id="detailAvatar" style="width:90px; height:90px; border-radius:50%; object-fit:cover;" class="border p-1 mb-2" />
