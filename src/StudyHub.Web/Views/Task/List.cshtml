                    <td style="padding: 18px 24px; color: #64748b; font-weight: 500;"><i class="fa-regular fa-calendar me-1"></i> 02/07/2024</td>
                    <td style="padding: 18px 24px;"><span class="badge-custom badge-high">Cao</span></td>
                    <td style="padding: 18px 24px;"><span class="status-badge-custom status-todo">Cần thực hiện</span></td>
                    <td style="padding: 18px 24px; text-align: center;">
                        <div class="d-flex justify-content-center gap-2">
                            <button class="btn btn-sm btn-outline-primary action-btn-play" style="border-radius: 8px;" onclick="changeStatus(this, 'Đang thực hiện')"><i class="fa-solid fa-play"></i></button>
                            <button class="btn btn-sm btn-outline-danger" style="border-radius: 8px;" onclick="deleteRow(this)"><i class="fa-regular fa-trash-can"></i></button>
                        </div>
                    </td>
                </tr>
                <!-- Row 5 -->
                <tr class="task-row-item" data-tag="Cơ sở dữ liệu" data-priority="Cao" data-status="Đang thực hiện">
                    <td style="padding: 18px 24px; font-weight: 500; color: #64748b;" class="row-index">5</td>
                    <td style="padding: 18px 24px;">
                        <div class="d-flex align-items-center gap-3">
                            <input type="checkbox" class="form-check-input" style="cursor: pointer;" onchange="toggleRowComplete(this)" />
                            <span class="fw-semibold text-dark task-title">Bài tập thiết kế CSDL</span>
                        </div>
                    </td>
                    <td style="padding: 18px 24px;"><span class="badge rounded-pill bg-light text-secondary" style="font-size: 0.75rem; padding: 6px 12px; border: 1px solid #e2e8f0;">Cơ sở dữ liệu</span></td>
                    <td style="padding: 18px 24px; color: #64748b; font-weight: 500;"><i class="fa-regular fa-calendar me-1"></i> 25/06/2024</td>
                    <td style="padding: 18px 24px;"><span class="badge-custom badge-high">Cao</span></td>
                    <td style="padding: 18px 24px;"><span class="status-badge-custom status-progress">Đang thực hiện</span></td>
                    <td style="padding: 18px 24px; text-align: center;">
                        <div class="d-flex justify-content-center gap-2">
                            <button class="btn btn-sm btn-outline-success action-btn-check" style="border-radius: 8px;" onclick="changeStatus(this, 'Hoàn thành')"><i class="fa-solid fa-check"></i></button>
                            <button class="btn btn-sm btn-outline-danger" style="border-radius: 8px;" onclick="deleteRow(this)"><i class="fa-regular fa-trash-can"></i></button>
                        </div>
                    </td>
                </tr>
                <!-- Row 6 -->
                <tr class="task-row-item" data-tag="Giải thuật" data-priority="Trung bình" data-status="Đang thực hiện">
                    <td style="padding: 18px 24px; font-weight: 500; color: #64748b;" class="row-index">6</td>
                    <td style="padding: 18px 24px;">
                        <div class="d-flex align-items-center gap-3">
                            <input type="checkbox" class="form-check-input" style="cursor: pointer;" onchange="toggleRowComplete(this)" />
                            <span class="fw-semibold text-dark task-title">Ôn tập thuật toán</span>
                        </div>
                    </td>
                    <td style="padding: 18px 24px;"><span class="badge rounded-pill bg-light text-secondary" style="font-size: 0.75rem; padding: 6px 12px; border: 1px solid #e2e8f0;">Giải thuật</span></td>
                    <td style="padding: 18px 24px; color: #64748b; font-weight: 500;"><i class="fa-regular fa-calendar me-1"></i> 29/06/2024</td>
                    <td style="padding: 18px 24px;"><span class="badge-custom badge-medium">Trung bình</span></td>
                    <td style="padding: 18px 24px;"><span class="status-badge-custom status-progress">Đang thực hiện</span></td>
