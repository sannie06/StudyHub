@{
    ViewData["Title"] = "Danh sách công việc";
}

<style>
    /* Custom status badge styling to avoid conflicts with global badge rules */
    .status-badge-custom {
        padding: 6px 12px;
        font-size: 0.75rem;
        font-weight: 600;
        border-radius: 20px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: fit-content;
    }
    .status-todo {
        background-color: rgba(124, 58, 237, 0.1) !important;
        color: #7C3AED !important;
    }
    .status-progress {
        background-color: rgba(245, 158, 11, 0.1) !important;
        color: #D97706 !important;
    }
    .status-done {
        background-color: rgba(16, 185, 129, 0.1) !important;
        color: #10B981 !important;
    }
</style>

<!-- Heading -->
<div class="row align-items-center mb-4">
    <div class="col-md-8">
        <h2 class="fw-bold mb-1" style="font-size: 1.8rem;">Danh sách công việc</h2>
        <p class="text-secondary mb-0">Theo dõi, quản lý và sắp xếp các công việc cá nhân dễ dàng.</p>
    </div>
</div>

<!-- Filter Bar -->
<div class="glass-card p-3 mb-4">
    <div class="row g-3 align-items-center justify-content-between">
        <div class="col-xl-3 col-md-4">
            <div class="position-relative">
                <i class="fa-solid fa-magnifying-glass text-secondary" style="position: absolute; left: 12px; top: 50%; transform: translateY(-50%);"></i>
                <input type="text" class="glass-control p-2 ps-5" placeholder="Tìm kiếm công việc..." id="searchInput" onkeyup="filterTable()" />
            </div>
        </div>
        <div class="col-xl-7 col-md-8 d-flex flex-wrap gap-2 justify-content-md-end">
            <select class="glass-control p-2 border" id="tagFilter" onchange="filterTable()" style="width: auto;">
                <option value="">Môn học: Tất cả</option>
                <option value="PTPM">PTPM</option>
                <option value="Java">Java</option>
                <option value="Web">Web</option>
                <option value="Cơ sở dữ liệu">Cơ sở dữ liệu</option>
                <option value="Giải thuật">Giải thuật</option>
                <option value="Cấu trúc dữ liệu">Cấu trúc dữ liệu</option>
                <option value="Kỹ năng">Kỹ năng</option>
            </select>
            <select class="glass-control p-2 border" id="priorityFilter" onchange="filterTable()" style="width: auto;">
                <option value="">Ưu tiên: Tất cả</option>
                <option value="Cao">Cao</option>
                <option value="Trung bình">Trung bình</option>
                <option value="Thấp">Thấp</option>
            </select>
            <select class="glass-control p-2 border" id="statusFilter" onchange="filterTable()" style="width: auto;">
                <option value="">Trạng thái: Tất cả</option>
                <option value="Cần thực hiện">Cần thực hiện</option>
                <option value="Đang thực hiện">Đang thực hiện</option>
                <option value="Hoàn thành">Hoàn thành</option>
            </select>
            <button class="btn btn-primary-custom p-2 px-3" data-bs-toggle="modal" data-bs-target="#addTaskModal"><i class="fa-solid fa-plus me-1"></i> Tạo công việc mới</button>
        </div>
    </div>
</div>

<!-- Task Table Area -->
<div class="glass-card p-0 mb-4" style="overflow: hidden; border: 1px solid #e5e7eb !important;">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0" id="taskTable" style="border-collapse: collapse;">
            <thead style="background: #f8fafc; border-bottom: 1px solid #f1f5f9;">
                <tr>
                    <th style="padding: 18px 24px; font-weight: 600; color: #475569; font-size: 0.85rem; width: 60px;">STT</th>
                    <th style="padding: 18px 24px; font-weight: 600; color: #475569; font-size: 0.85rem;">Công việc</th>
                    <th style="padding: 18px 24px; font-weight: 600; color: #475569; font-size: 0.85rem; width: 160px;">Phân loại</th>
                    <th style="padding: 18px 24px; font-weight: 600; color: #475569; font-size: 0.85rem; width: 150px;">Hạn chót</th>
                    <th style="padding: 18px 24px; font-weight: 600; color: #475569; font-size: 0.85rem; width: 140px;">Độ ưu tiên</th>
                    <th style="padding: 18px 24px; font-weight: 600; color: #475569; font-size: 0.85rem; width: 160px;">Trạng thái</th>
                    <th style="padding: 18px 24px; font-weight: 600; color: #475569; font-size: 0.85rem; width: 150px; text-align: center;">Thao tác</th>
                </tr>
            </thead>
            <tbody style="border: none;">
                <!-- Row 1 -->
                <tr class="task-row-item" data-tag="PTPM" data-priority="Cao" data-status="Cần thực hiện">
                    <td style="padding: 18px 24px; font-weight: 500; color: #64748b;" class="row-index">1</td>
                    <td style="padding: 18px 24px;">
                        <div class="d-flex align-items-center gap-3">
                            <input type="checkbox" class="form-check-input" style="cursor: pointer;" onchange="toggleRowComplete(this)" />
                            <span class="fw-semibold text-dark task-title">Làm báo cáo UML</span>
                        </div>
                    </td>
                    <td style="padding: 18px 24px;"><span class="badge rounded-pill bg-light text-secondary" style="font-size: 0.75rem; padding: 6px 12px; border: 1px solid #e2e8f0;">PTPM</span></td>
                    <td style="padding: 18px 24px; color: #64748b; font-weight: 500;"><i class="fa-regular fa-calendar me-1"></i> 30/06/2024</td>
                    <td style="padding: 18px 24px;"><span class="badge-custom badge-high">Cao</span></td>
                    <td style="padding: 18px 24px;"><span class="status-badge-custom status-todo">Cần thực hiện</span></td>
                    <td style="padding: 18px 24px; text-align: center;">
                        <div class="d-flex justify-content-center gap-2">
                            <button class="btn btn-sm btn-outline-primary action-btn-play" style="border-radius: 8px;" onclick="changeStatus(this, 'Đang thực hiện')"><i class="fa-solid fa-play"></i></button>
                            <button class="btn btn-sm btn-outline-danger" style="border-radius: 8px;" onclick="deleteRow(this)"><i class="fa-regular fa-trash-can"></i></button>
                        </div>
                    </td>
                </tr>
                <!-- Row 2 -->
                <tr class="task-row-item" data-tag="Java" data-priority="Trung bình" data-status="Cần thực hiện">
                    <td style="padding: 18px 24px; font-weight: 500; color: #64748b;" class="row-index">2</td>
                    <td style="padding: 18px 24px;">
                        <div class="d-flex align-items-center gap-3">
                            <input type="checkbox" class="form-check-input" style="cursor: pointer;" onchange="toggleRowComplete(this)" />
                            <span class="fw-semibold text-dark task-title">Ôn tập Java OOP</span>
                        </div>
                    </td>
                    <td style="padding: 18px 24px;"><span class="badge rounded-pill bg-light text-secondary" style="font-size: 0.75rem; padding: 6px 12px; border: 1px solid #e2e8f0;">Java</span></td>
                    <td style="padding: 18px 24px; color: #64748b; font-weight: 500;"><i class="fa-regular fa-calendar me-1"></i> 28/06/2024</td>
                    <td style="padding: 18px 24px;"><span class="badge-custom badge-medium">Trung bình</span></td>
                    <td style="padding: 18px 24px;"><span class="status-badge-custom status-todo">Cần thực hiện</span></td>
