                <tr class="task-row-item" data-tag="PTPM" data-priority="Thấp" data-status="Đang thực hiện">
                    <td style="padding: 18px 24px; font-weight: 500; color: #64748b;" class="row-index">7</td>
                    <td style="padding: 18px 24px;">
                        <div class="d-flex align-items-center gap-3">
