                    <td style="padding: 18px 24px; color: #64748b; font-weight: 500;"><i class="fa-regular fa-calendar me-1"></i> 20/06/2024</td>
                    <td style="padding: 18px 24px;"><span class="badge-custom badge-low">Thấp</span></td>
                    <td style="padding: 18px 24px;"><span class="status-badge-custom status-progress">Đang thực hiện</span></td>
                    <td style="padding: 18px 24px; text-align: center;">
                        <div class="d-flex justify-content-center gap-2">
                            <button class="btn btn-sm btn-outline-success action-btn-check" style="border-radius: 8px;" onclick="changeStatus(this, 'Hoàn thành')"><i class="fa-solid fa-check"></i></button>
                            <button class="btn btn-sm btn-outline-danger" style="border-radius: 8px;" onclick="deleteRow(this)"><i class="fa-regular fa-trash-can"></i></button>
