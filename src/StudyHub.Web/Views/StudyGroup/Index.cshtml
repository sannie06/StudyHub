@section Scripts {
    <script>
        function sendChatMessage() {
            var msg = $('#chatInput').val();
            if (msg.trim() === '') return;

            let myMsgHtml = `
                <div class="chat-message user">
                    <img src="https://images.unsplash.com/photo-1534528741775-53994a69daeb?auto=format&fit=crop&w=40&q=80" style="width: 36px; height: 36px; border-radius: 50%;" />
                    <div>
                        <div class="small fw-bold text-end text-dark mb-1">Bạn <span class="text-secondary fw-normal ms-1" style="font-size: 0.7rem;">Vừa xong</span></div>
                        <div class="message-bubble">
                            ${msg}
                        </div>
                    </div>
                </div>
            `;
            
            $('#chatArea').append(myMsgHtml);
            $('#chatInput').val('');
            
            // Scroll to bottom
            var chatArea = document.getElementById("chatArea");
            chatArea.scrollTop = chatArea.scrollHeight;

            // Mock reply after 1s
            setTimeout(() => {
                let replyHtml = `
                    <div class="chat-message ai">
                        <img src="https://images.unsplash.com/photo-1535713875002-d1d0cf377fde?auto=format&fit=crop&w=40&q=80" style="width: 36px; height: 36px; border-radius: 50%;" />
                        <div>
                            <div class="small fw-bold text-dark mb-1">Nguyễn Văn A <span class="text-secondary fw-normal ms-1" style="font-size: 0.7rem;">Vừa xong</span></div>
                            <div class="message-bubble">
                                Nhất trí nhé! Mình sẽ tạo Google Meet và gửi link cho mọi người sau.
                            </div>
                        </div>
                    </div>
                `;
                $('#chatArea').append(replyHtml);
                chatArea.scrollTop = chatArea.scrollHeight;
            }, 1000);
        }

        function handleChatEnter(e) {
            if (e.which === 13) {
                sendChatMessage();
            }
        }
    </script>
}
