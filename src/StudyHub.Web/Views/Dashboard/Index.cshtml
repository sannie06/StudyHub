                        }
                    }
                }
            });
        });

        function completeTaskAlert(checkbox) {
            if (checkbox.checked) {
                Swal.fire({
                    title: 'Hoàn thành công việc!',
                    text: 'Chúc mừng bạn đã hoàn thành nhiệm vụ này.',
                    icon: 'success',
                    timer: 1500,
                    showConfirmButton: false
                });
                $(checkbox).closest('.d-flex').find('.fw-bold').css('text-decoration', 'line-through').css('color', '#94a3b8');
            } else {
                $(checkbox).closest('.d-flex').find('.fw-bold').css('text-decoration', 'none').css('color', '#0f172a');
            }
        }
    </script>
}
