@{
    ViewData["Title"] = "Pomodoro / Focus Mode";
}

<!-- Heading -->
<div class="row align-items-center mb-4">
    <div class="col-md-8">
        <h2 class="fw-bold mb-1" style="font-size: 1.8rem;">Pomodoro / Focus Mode</h2>
        <p class="text-secondary mb-0">Tập trung học tập • Nâng cao hiệu suất</p>
    </div>
</div>

<div class="row g-4">
    <!-- Left Column: Current task & other tasks (3 columns) -->
    <div class="col-lg-3 col-md-12">
        <!-- Active Task -->
        <div class="glass-card mb-4">
            <div class="card-title-custom">
                <span>CÔNG VIỆC ĐANG TẬP TRUNG</span>
                <span class="text-primary small" style="cursor:pointer;" onclick="Swal.fire('Thay đổi công việc', 'Chọn công việc khác từ danh sách để tập trung.', 'info')">Thay đổi</span>
            </div>
            
            <div class="d-flex align-items-center justify-content-between mb-2">
                <span class="badge bg-primary bg-opacity-10 text-primary fw-bold" style="font-size:0.75rem;">Đồ án tốt nghiệp</span>
                <i class="fa-solid fa-star text-warning"></i>
            </div>
            
            <h6 class="fw-bold text-dark mb-2">Làm báo cáo đồ án tốt nghiệp</h6>
            <p class="text-secondary small mb-3">Hoàn thiện chương 3: Thiết kế hệ thống và triển khai chức năng.</p>
            
            <div class="d-flex flex-column gap-2 small border-top pt-2">
                <div class="d-flex justify-content-between">
                    <span class="text-secondary">Deadline</span>
                    <strong class="text-dark">30/06/2024</strong>
                </div>
                <div class="d-flex justify-content-between">
                    <span class="text-secondary">Ưu tiên</span>
                    <span class="badge-custom badge-high">Cao</span>
                </div>
                <div class="d-flex justify-content-between align-items-center">
                    <span class="text-secondary">Tiến độ</span>
                    <div class="d-flex align-items-center gap-2" style="width: 60%;">
                        <div class="progress flex-grow-1" style="height: 6px; background:#f1f5f9;">
                            <div class="progress-bar bg-primary" role="progressbar" style="width: 60%;"></div>
                        </div>
                        <strong class="text-dark">60%</strong>
                    </div>
                </div>
            </div>
            
            <button class="btn btn-secondary-custom btn-sm w-100 mt-3" onclick="location.href='/Task'">Xem chi tiết công việc <i class="fa-solid fa-arrow-right ms-1"></i></button>
        </div>

        <!-- Other Tasks -->
        <div class="glass-card">
            <div class="card-title-custom">
                <span>DANH SÁCH CÔNG VIỆC KHÁC</span>
            </div>
            <div class="d-flex flex-column gap-3 small">
                <div class="d-flex align-items-center gap-2">
                    <span class="rounded-circle" style="width:8px; height:8px; background:#f59e0b;"></span>
                    <div class="flex-grow-1">
                        <div class="fw-bold text-dark text-truncate" style="max-width:140px;">Ôn tập môn Cơ sở dữ liệu</div>
                        <span class="text-secondary" style="font-size:0.7rem;">25/06/2024</span>
                    </div>
                    <span class="badge-custom badge-medium" style="font-size:0.6rem; padding: 2px 4px;">Trung bình</span>
                </div>
                <div class="d-flex align-items-center gap-2">
                    <span class="rounded-circle" style="width:8px; height:8px; background:#10b981;"></span>
                    <div class="flex-grow-1">
                        <div class="fw-bold text-dark text-truncate" style="max-width:140px;">Chuẩn bị bài thuyết trình</div>
                        <span class="text-secondary" style="font-size:0.7rem;">28/06/2024</span>
                    </div>
                    <span class="badge-custom badge-low" style="font-size:0.6rem; padding: 2px 4px;">Thấp</span>
                </div>
                <div class="d-flex align-items-center gap-2">
                    <span class="rounded-circle" style="width:8px; height:8px; background:#ef4444;"></span>
                    <div class="flex-grow-1">
                        <div class="fw-bold text-dark text-truncate" style="max-width:140px;">Đọc tài liệu ReactJS</div>
                        <span class="text-secondary" style="font-size:0.7rem;">27/06/2024</span>
                    </div>
                    <span class="badge-custom badge-high" style="font-size:0.6rem; padding: 2px 4px;">Cao</span>
                </div>
            </div>
            <button class="btn btn-secondary-custom btn-sm w-100 mt-3" onclick="location.href='/Task'">Xem tất cả <i class="fa-solid fa-arrow-right ms-1"></i></button>
        </div>
    </div>

    <!-- Center Column: Main Timer Clock (6 columns) -->
    <div class="col-lg-6 col-md-12 text-center d-flex flex-column justify-content-between">
        <div class="glass-card pomodoro-container h-100 justify-content-between py-4">
            
            <!-- Timer Mode selectors -->
            <div class="d-flex align-items-center justify-content-between w-100 mb-3 px-3">
                <div class="d-flex gap-2">
                    <button class="btn btn-primary-custom btn-sm px-3" style="border-radius:20px;" onclick="setMode('work')"><i class="fa-solid fa-stopwatch me-1"></i> Pomodoro</button>
                    <button class="btn btn-secondary-custom btn-sm px-3 border-0" style="border-radius:20px;" onclick="setMode('short')"><i class="fa-solid fa-mug-hot me-1"></i> Short Break</button>
                    <button class="btn btn-secondary-custom btn-sm px-3 border-0" style="border-radius:20px;" onclick="setMode('long')"><i class="fa-solid fa-bed me-1"></i> Long Break</button>
                </div>
                <button class="btn btn-secondary-custom btn-sm px-3" onclick="Swal.fire('Lịch sử', 'Chức năng đang tải lịch sử các phiên học...', 'info')"><i class="fa-solid fa-history me-1"></i> Lịch sử phiên</button>
            </div>

            <!-- Big Clock SVG Ring and Display -->
            <div class="timer-circle-wrapper my-3" style="width:240px; height:240px;">
                <svg class="timer-svg" style="width:240px; height:240px;">
                    <circle cx="120" cy="120" r="105" stroke="#f1f5f9" stroke-width="6" fill="transparent" />
                    <!-- Tick marks or dotted background simulated -->
                    <circle class="timer-progress" id="timerProgress" cx="120" cy="120" r="105" stroke="#4f46e5" stroke-dasharray="660" stroke-dashoffset="0" stroke-width="6" fill="transparent" stroke-linecap="round"></circle>
                </svg>
                <div class="text-center position-absolute">
                    <div class="text-danger small fw-bold mb-1"><i class="fa-solid fa-pepper-hot"></i> Pomodoro</div>
                    <div class="timer-time-display fw-bold" id="timeDisplay" style="font-size: 4rem; line-height: 1.1;">25:00</div>
                    <div class="text-secondary small mt-1" style="font-size:0.75rem;">Hãy tập trung và học tập hiệu quả!</div>
                    <div class="badge bg-light text-primary border mt-2" style="font-size:0.7rem;">Mục tiêu: Hoàn thành chương 3</div>
                </div>
            </div>

            <!-- Central Control Buttons -->
            <div class="w-100 my-2">
                <!-- Big play button circle -->
                <button class="btn btn-primary-custom rounded-circle p-0 mb-3" id="startBtn" onclick="startTimer()" style="width:65px; height:65px; box-shadow:0 10px 15px -3px rgba(79, 70, 229, 0.4);">
                    <i class="fa-solid fa-play fs-3"></i>
                </button>
                <button class="btn btn-warning rounded-circle p-0 mb-3 d-none" id="pauseBtn" onclick="pauseTimer()" style="width:65px; height:65px; box-shadow:0 10px 15px -3px rgba(245, 158, 11, 0.4); border:0; color:#fff;">
                    <i class="fa-solid fa-pause fs-3"></i>
                </button>
                
                <div class="d-flex justify-content-center gap-3">
                    <button class="btn btn-secondary-custom px-4" id="resumeBtn" onclick="pauseTimer()" disabled><i class="fa-solid fa-pause me-1"></i> Tạm dừng</button>
                    <button class="btn btn-secondary-custom px-4" onclick="resetTimer()"><i class="fa-solid fa-rotate-left me-1"></i> Đặt lại</button>
                </div>
            </div>

            <!-- Rules banner -->
            <div class="w-100 bg-light p-3 rounded-3 border d-flex justify-content-around text-center mt-3" style="font-size:0.72rem;">
                <div>
                    <i class="fa-solid fa-bullseye text-primary fs-5 mb-1"></i>
                    <div>1. Chọn việc</div>
                </div>
                <i class="fa-solid fa-chevron-right text-secondary mt-2"></i>
                <div>
                    <i class="fa-solid fa-stopwatch text-primary fs-5 mb-1"></i>
                    <div>2. Tập trung 25p</div>
                </div>
                <i class="fa-solid fa-chevron-right text-secondary mt-2"></i>
                <div>
                    <i class="fa-solid fa-coffee text-primary fs-5 mb-1"></i>
                    <div>3. Giải lao 5p</div>
                </div>
                <i class="fa-solid fa-chevron-right text-secondary mt-2"></i>
                <div>
                    <i class="fa-solid fa-award text-primary fs-5 mb-1"></i>
                    <div>4. Lặp lại 4 lần</div>
                </div>
            </div>

            <!-- Focus toggles settings -->
            <div class="w-100 text-start border-top pt-3 mt-3 px-2">
                <span class="small fw-bold text-dark d-block mb-3">CHẾ ĐỘ FOCUS (Hạn chế xao nhãng)</span>
                <div class="row g-3" style="font-size: 0.8rem;">
                    <div class="col-md-6 d-flex align-items-center justify-content-between">
                        <span class="text-secondary"><i class="fa-solid fa-bell-slash me-1"></i> Tắt thông báo</span>
                        <div class="form-check form-switch m-0">
                            <input class="form-check-input" type="checkbox" role="switch" checked>
                        </div>
                    </div>
                    <div class="col-md-6 d-flex align-items-center justify-content-between">
                        <span class="text-secondary"><i class="fa-solid fa-globe me-1"></i> Chặn trang web</span>
                        <div class="form-check form-switch m-0">
                            <input class="form-check-input" type="checkbox" role="switch" checked>
                        </div>
                    </div>
                    <div class="col-md-6 d-flex align-items-center justify-content-between">
                        <span class="text-secondary"><i class="fa-solid fa-music me-1"></i> Âm thanh nền</span>
                        <div class="form-check form-switch m-0">
                            <input class="form-check-input" type="checkbox" role="switch" id="ambientSoundToggle" onchange="toggleAmbientVolume(this)">
                        </div>
                    </div>
                    <div class="col-md-6 d-flex align-items-center justify-content-between">
                        <span class="text-secondary"><i class="fa-solid fa-expand me-1"></i> Toàn màn hình</span>
                        <div class="form-check form-switch m-0">
                            <input class="form-check-input" type="checkbox" role="switch">
                        </div>
                    </div>
                </div>
                
                <!-- Synthesized Noise ambient slider -->
                <div id="ambientVolumeBlock" class="mt-3 bg-light p-2 rounded border d-none">
                    <div class="d-flex align-items-center gap-2 mb-2 justify-content-center">
                        <button class="btn btn-secondary-custom btn-sm p-1 px-2" id="noiseRain" onclick="changeNoiseType('rain')"><i class="fa-solid fa-cloud-rain"></i> Mưa</button>
                        <button class="btn btn-secondary-custom btn-sm p-1 px-2 active" id="noiseWaves" onclick="changeNoiseType('waves')"><i class="fa-solid fa-water"></i> Sóng</button>
                        <button class="btn btn-secondary-custom btn-sm p-1 px-2" id="noiseWind" onclick="changeNoiseType('pink')"><i class="fa-solid fa-wind"></i> Gió</button>
                    </div>
                    <div class="d-flex align-items-center gap-2">
                        <i class="fa-solid fa-volume-low text-secondary small"></i>
                        <input type="range" class="form-range" id="volControl" min="0" max="1" step="0.05" value="0.5" onchange="setAmbientVolume(this.value)" />
                        <i class="fa-solid fa-volume-high text-secondary small"></i>
                    </div>
                </div>
            </div>

        </div>
    </div>

    <!-- Right Column: Stats & Logs (3 columns) -->
    <div class="col-lg-3 col-md-12">
        <!-- Daily Stats -->
        <div class="glass-card mb-4">
            <div class="card-title-custom">
                <span>THỐNG KÊ HÔM NAY</span>
                <a href="#" class="text-primary small text-decoration-none">Xem chi tiết</a>
            </div>
            <div class="row g-3 text-center mb-1">
                <div class="col-6 border-end border-bottom pb-2">
                    <i class="fa-regular fa-clock text-primary fs-5 mb-1 d-block"></i>
                    <strong class="text-dark d-block">4</strong>
                    <span class="text-secondary" style="font-size:0.7rem;">Phiên hoàn thành</span>
                </div>
                <div class="col-6 border-bottom pb-2">
                    <i class="fa-solid fa-brain text-primary fs-5 mb-1 d-block"></i>
                    <strong class="text-dark d-block">2h 15m</strong>
                    <span class="text-secondary" style="font-size:0.7rem;">Tổng thời gian học</span>
                </div>
                <div class="col-6 border-end pt-2">
                    <i class="fa-solid fa-fire text-primary fs-5 mb-1 d-block"></i>
                    <strong class="text-dark d-block">7 ngày</strong>
                    <span class="text-secondary" style="font-size:0.7rem;">Chuỗi tập trung</span>
                </div>
                <div class="col-6 pt-2">
                    <i class="fa-solid fa-chart-line text-primary fs-5 mb-1 d-block"></i>
                    <strong class="text-dark d-block">85%</strong>
                    <span class="text-secondary" style="font-size:0.7rem;">Hiệu suất học tập</span>
                </div>
            </div>
        </div>

        <!-- History logs -->
        <div class="glass-card mb-4">
            <div class="card-title-custom">
                <span>LỊCH SỬ PHIÊN HỌC</span>
            </div>
            <div class="d-flex flex-column gap-3 small" style="font-size:0.8rem;">
                <div class="d-flex align-items-center justify-content-between">
                    <div class="d-flex align-items-center gap-2">
                        <i class="fa-solid fa-pepper-hot text-danger"></i>
                        <div>
                            <div class="fw-bold text-dark">Pomodoro 4</div>
                            <span class="text-secondary" style="font-size:0.7rem;">25 phút</span>
                        </div>
                    </div>
                    <span class="text-secondary">10:30 - 10:55</span>
                    <i class="fa-solid fa-circle-check text-success"></i>
                </div>
                <div class="d-flex align-items-center justify-content-between">
                    <div class="d-flex align-items-center gap-2">
                        <i class="fa-solid fa-pepper-hot text-danger"></i>
                        <div>
                            <div class="fw-bold text-dark">Pomodoro 3</div>
                            <span class="text-secondary" style="font-size:0.7rem;">25 phút</span>
                        </div>
                    </div>
                    <span class="text-secondary">09:55 - 10:20</span>
                    <i class="fa-solid fa-circle-check text-success"></i>
                </div>
                <div class="d-flex align-items-center justify-content-between">
                    <div class="d-flex align-items-center gap-2">
                        <i class="fa-solid fa-mug-hot text-secondary"></i>
                        <div>
                            <div class="fw-bold text-dark">Short Break</div>
                            <span class="text-secondary" style="font-size:0.7rem;">5 phút</span>
                        </div>
                    </div>
                    <span class="text-secondary">09:50 - 09:55</span>
                    <i class="fa-solid fa-circle-check text-success"></i>
                </div>
            </div>
            <button class="btn btn-secondary-custom btn-sm w-100 mt-3" onclick="Swal.fire('Lịch sử đầy đủ', 'Đang tải toàn bộ dữ liệu lịch sử...', 'info')">Xem tất cả lịch sử</button>
        </div>

        <!-- AI Assistant recommendation box -->
        <div class="glass-card">
            <div class="card-title-custom">
                <span class="text-primary"><i class="fa-solid fa-robot"></i> AI Assistant</span>
                <span class="badge bg-secondary bg-opacity-10 text-secondary" style="font-size:0.6rem;">Beta</span>
            </div>
            <p class="text-dark small mb-2">Bạn đã hoàn thành 4 phiên Pomodoro hôm nay! Hiệu suất của bạn cao hơn <strong>20%</strong> so với trung bình.</p>
            <div class="bg-primary bg-opacity-10 text-primary p-2 rounded small mb-2" style="font-size:0.75rem;">
                <strong>Gợi ý:</strong> Bạn nên nghỉ dài 15 phút sau phiên thứ 4 để tái tạo năng lượng và duy trì sự tập trung.
            </div>
            <button class="btn btn-primary-custom btn-sm w-100" onclick="Swal.fire('AI Focus Analysis', 'Phân tích hiệu suất học tập cho thấy bạn tập trung tốt nhất vào khung giờ 8:00 - 10:00 sáng.', 'success')">Xem chi tiết phân tích</button>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        let timer = null;
        let totalTime = 25 * 60;
        let timeRemaining = totalTime;
        let isPaused = true;
        let activeMode = 'work'; // 'work', 'short', 'long'

        const progressRing = document.getElementById('timerProgress');
        const totalOffset = 660; // 2 * PI * R where R=105

        function updateDisplay() {
            let minutes = Math.floor(timeRemaining / 60);
            let seconds = timeRemaining % 60;
            
            minutes = minutes < 10 ? '0' + minutes : minutes;
            seconds = seconds < 10 ? '0' + seconds : seconds;
            
            $('#timeDisplay').text(`${minutes}:${seconds}`);

            let fraction = timeRemaining / totalTime;
            let offset = totalOffset - (fraction * totalOffset);
            progressRing.style.strokeDashoffset = offset;
        }

        function setMode(mode) {
            activeMode = mode;
            pauseTimer();
            if (mode === 'work') {
                totalTime = 25 * 60;
            } else if (mode === 'short') {
                totalTime = 5 * 60;
            } else if (mode === 'long') {
                totalTime = 15 * 60;
            }
            timeRemaining = totalTime;
            updateDisplay();
        }

        function startTimer() {
            if (!isPaused) return;
            isPaused = false;
            
            $('#startBtn').addClass('d-none');
            $('#pauseBtn').removeClass('d-none');
            $('#resumeBtn').removeAttr('disabled').text('Tạm dừng');

            timer = setInterval(() => {
                if (timeRemaining > 0) {
                    timeRemaining--;
                    updateDisplay();
                } else {
                    clearInterval(timer);
                    isPaused = true;
                    playAlarmSound();
                    resetTimer();
                }
            }, 1000);
        }

        function pauseTimer() {
            isPaused = true;
            clearInterval(timer);
            $('#pauseBtn').addClass('d-none');
            $('#startBtn').removeClass('d-none');
            $('#resumeBtn').attr('disabled', true);
        }

        function resetTimer() {
            isPaused = true;
            clearInterval(timer);
            timeRemaining = totalTime;
            updateDisplay();
            $('#pauseBtn').addClass('d-none');
            $('#startBtn').removeClass('d-none');
            $('#resumeBtn').attr('disabled', true);
        }

        function playAlarmSound() {
            let ctx = new (window.AudioContext || window.webkitAudioContext)();
            let osc = ctx.createOscillator();
            let gain = ctx.createGain();
            osc.connect(gain);
            gain.connect(ctx.destination);
            osc.frequency.setValueAtTime(800, ctx.currentTime);
            gain.gain.setValueAtTime(0.3, ctx.currentTime);
            osc.start();
            osc.stop(ctx.currentTime + 1);
            
            Swal.fire({
                title: 'Hoàn thành!',
                text: 'Thời gian đã trôi qua. Hãy nghỉ ngơi!',
                icon: 'success'
            });
        }

        // Web Audio Synthesized Noise
        let audioContext = null;
        let noiseSource = null;
        let noiseGainNode = null;
        let noiseType = 'waves';

        function initAudio() {
            if (!audioContext) {
                audioContext = new (window.AudioContext || window.webkitAudioContext)();
            }
        }

        function buildBuffer(type) {
            initAudio();
            let size = 2 * audioContext.sampleRate;
            let buffer = audioContext.createBuffer(1, size, audioContext.sampleRate);
            let data = buffer.getChannelData(0);
            
            let b0 = 0, b1 = 0, b2 = 0, b3 = 0, b4 = 0, b5 = 0, b6 = 0;

            for (let i = 0; i < size; i++) {
                let white = Math.random() * 2 - 1;
                if (type === 'pink' || type === 'rain') {
                    b0 = 0.99886 * b0 + white * 0.0555179;
                    b1 = 0.99332 * b1 + white * 0.0750759;
                    b2 = 0.96900 * b2 + white * 0.1538520;
                    b3 = 0.86650 * b3 + white * 0.3104856;
                    b4 = 0.55000 * b4 + white * 0.5329522;
                    b5 = -0.7616 * b5 - white * 0.0168980;
                    let pink = b0 + b1 + b2 + b3 + b4 + b5 + b6 + white * 0.5362;
                    b6 = white * 0.115926;
                    data[i] = pink * (type === 'rain' ? 0.05 : 0.07);
                } else {
                    data[i] = white * 0.05;
                }
            }
            return buffer;
        }

        function playNoise() {
            stopNoise();
            initAudio();
            
            noiseSource = audioContext.createBufferSource();
            noiseSource.buffer = buildBuffer(noiseType);
            noiseSource.loop = true;

            noiseGainNode = audioContext.createGain();
            noiseGainNode.gain.setValueAtTime($('#volControl').val() * 0.1, audioContext.currentTime);

            noiseSource.connect(noiseGainNode);
            noiseGainNode.connect(audioContext.destination);

            if (noiseType === 'waves') {
                // Wave modulation
                let modulator = audioContext.createOscillator();
                let modGain = audioContext.createGain();
                modulator.frequency.value = 0.1; // 10s wave cycles
                modGain.gain.value = 0.03;
                modulator.connect(modGain);
                modGain.connect(noiseGainNode.gain);
                modulator.start();
            }

            noiseSource.start();
        }

        function stopNoise() {
            if (noiseSource) {
                noiseSource.stop();
                noiseSource.disconnect();
                noiseSource = null;
            }
        }

        function toggleAmbientVolume(chk) {
            if (chk.checked) {
                $('#ambientVolumeBlock').removeClass('d-none');
                playNoise();
            } else {
                $('#ambientVolumeBlock').addClass('d-none');
                stopNoise();
            }
        }

        function changeNoiseType(type) {
            noiseType = type;
            $('.sound-toggle-btn').removeClass('active');
            if (type === 'rain') $('#noiseRain').addClass('active');
            if (type === 'waves') $('#noiseWaves').addClass('active');
            if (type === 'pink') $('#noiseWind').addClass('active');
            
            if ($('#ambientSoundToggle').is(':checked')) {
                playNoise();
            }
        }

        function setAmbientVolume(val) {
            if (noiseGainNode && audioContext) {
                noiseGainNode.gain.setValueAtTime(val * 0.1, audioContext.currentTime);
            }
        }

        updateDisplay();
    </script>
}
